<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <!-- ================================================================= -->
    <!-- MAIN CHAT CANVAS                                                  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar (Desktop Breadcrumb & Controls) -->
        <RelativeLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_surface"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <!-- Hamburger Sidebar Toggle Button -->
            <TextView
                android:id="@+id/btn_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:text="☰"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <!-- Breadcrumb Navigation -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/btn_menu"
                android:layout_toLeftOf="@+id/top_right_actions"
                android:layout_marginLeft="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nitro-C"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:text="/"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_convo_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discord Bot Feature..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Right Controls: Status Pill & Settings -->
            <LinearLayout
                android:id="@+id/top_right_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@color/status_connected" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="Live"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:padding="6dp"
                    android:text="⚙"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Chat Message Stream -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="0dp">

            <ListView
                android:id="@+id/lv_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="8dp"
                android:clipToPadding="false"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:transcriptMode="alwaysScroll"
                android:stackFromBottom="true" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Antigravity Mobile"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============================================================= -->
        <!-- BOTTOM PANEL: THINKING STATE + RUNNING TASKS + INPUT BOX      -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

            <!-- 1. Thinking / Progress Indicator Banner -->
            <LinearLayout
                android:id="@+id/banner_thinking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_tasks_banner"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_thinking_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⟳"
                    android:textColor="@color/accent_blue_glow"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_thinking_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Antigravity is thinking..."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Running Tasks Banner (Collapsible) -->
            <LinearLayout
                android:id="@+id/banner_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_tasks_banner"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp">

                <!-- Header Row -->
                <RelativeLayout
                    android:id="@+id/tasks_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tasks_spinner_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⟳"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_tasks_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="3 tasks running"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_tasks_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:text="⌵"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Tasks Details Container -->
                <LinearLayout
                    android:id="@+id/tasks_content_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_task_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="⟳ Agent task · Running tests"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_task_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="⟳ node bridge_server.mjs"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_task_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="⟳ npm run build"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Desktop-Style Prompt Input Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_desktop"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="10dp">

                <!-- Multiline text area -->
                <EditText
                    android:id="@+id/et_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Ask Antigravity..."
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:maxLines="5"
                    android:minLines="1"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:inputType="text|textCapSentences" />

                <!-- Bottom Bar: Model Selector + Action Buttons -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Attachment Plus -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingRight="8dp"
                            android:paddingLeft="2dp"
                            android:text="+"
                            android:textColor="@color/text_muted"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Model Selection Pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_model"
                            android:gravity="center_vertical"
                            android:paddingLeft="8dp"
                            android:paddingTop="4dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gemini 3.8 Flash Medium"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                android:text="✨ ⌵"
                                android:textColor="@color/folder_yellow"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right Buttons: Send -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Send Button -->
                        <FrameLayout
                            android:id="@+id/btn_send"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_btn_send_blue"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/btn_send_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="→"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- SLIDING DRAWER DIM OVERLAY                                        -->
    <!-- ================================================================= -->
    <View
        android:id="@+id/drawer_dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000"
        android:visibility="gone" />

    <!-- ================================================================= -->
    <!-- LEFT NAVIGATION DRAWER (DESKTOP SIDEBAR ALIGNED)                  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/left_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="@color/bg_sidebar"
        android:elevation="16dp"
        android:visibility="gone"
        android:orientation="vertical">

        <!-- Sidebar Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_model"
                    android:text="A"
                    android:textColor="@color/accent_blue_glow"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Antigravity"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_close_drawer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:text="✕"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- New Conversation Button -->
        <LinearLayout
            android:id="@+id/btn_new_conversation"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_new_chat_btn"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="New Conversation"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Navigation Sections -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="14dp"
                android:orientation="vertical">

                <!-- 1. History -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:text="🕒" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_width="24dp" android:layout_height="wrap_content" />
                    <TextView android:text="Conversation History" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 2. Automations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:text="⏱" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_width="24dp" android:layout_height="wrap_content" />
                    <TextView android:text="Automations" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 3. Customizations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:text="💼" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_width="24dp" android:layout_height="wrap_content" />
                    <TextView android:text="Customizations" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Projects (populated live from the desktop) -->
                <LinearLayout
                    android:id="@+id/drawer_projects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>

        <!-- Sidebar Bottom Settings -->
        <LinearLayout
            android:id="@+id/drawer_settings_item"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_surface"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:orientation="horizontal">
            <TextView android:text="⚙" android:textSize="16sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:text="Settings" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginLeft="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
